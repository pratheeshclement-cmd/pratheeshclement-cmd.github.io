rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'Owner' ||
        request.auth.token.role == 'Administrator' ||
        request.auth.token.admin == true
      );
    }

    // Users Collection — Users can read their own profile; Admins can read all profiles. Client writes prohibited.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // All mutations executed via Firebase Admin SDK on backend
    }

    // System Status Collection — Authenticated Admins only
    match /system/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // CRM Leads & Pipeline — Authenticated Admins/CRM Executives only
    match /crm/{leadId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Blog Posts & Portfolio Projects — Public Read for live site, Admin read for management. Client writes prohibited.
    match /blogs/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    // Default Fallback — Deny all unauthenticated/unmatched collection reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
